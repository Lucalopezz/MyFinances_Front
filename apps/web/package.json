{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:connection": "node --test --test-isolation=none tests/legacy/backend-connection.test.cjs tests/legacy/backend-fetch.test.cjs",
    "test:exports": "node --test --test-isolation=none tests/legacy/transaction-export.test.cjs",
    "test:notifications": "node --test --test-isolation=none tests/legacy/notifications.test.cjs",
    "test": "npm run test:legacy && vitest run --config tests/vitest.config.mts",
    "test:legacy": "node --test --test-isolation=none tests/legacy/*.test.cjs",
    "test:unit": "vitest run --config tests/vitest.config.mts tests/unit",
    "test:integration": "vitest run --config tests/vitest.config.mts tests/integration",
    "test:watch": "vitest --config tests/vitest.config.mts",
    "test:cov": "vitest run --config tests/vitest.config.mts --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@tanstack/react-query": "^5.67.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.477.0",
    "next": "15.4.10",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-hot-toast": "^2.5.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.0.15",
    "@types/react": "19.1.8",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "tailwindcss": "^4",
    "typescript": "5.8.3",
    "vitest": "5.0.5"
  }
}
